<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<%-- only "dark" or "light" are taken from the cookie --%>
<c:set var="theme" value="${cookie.theme.value == 'dark' ? 'dark' : (cookie.theme.value == 'light' ? 'light' : '')}"/>
<%-- plain ASCII only: an included .jspf is read without the page's UTF-8 setting --%>
<!DOCTYPE html>
<html lang="en"<c:if test="${not empty theme}"> data-theme="${theme}"</c:if>>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="csrf" content="${sessionScope.csrf}">
    <title><c:out value="${empty pageTitle ? 'Pass It On' : pageTitle += ' - Pass It On'}"/></title>
    <link rel="icon" href="${ctx}/img/logo.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500..800&family=Inter:wght@400..700&family=Noto+Sans+Thai:wght@400..700&display=swap">
    <link rel="stylesheet" href="${ctx}/css/style.css?v=${applicationScope.assetVersion}">
    <script src="${ctx}/js/app.js?v=${applicationScope.assetVersion}" defer></script>
</head>
<body data-ctx="${ctx}">
<a class="skip-link" href="#main">Skip to content</a>

<header class="topbar">
    <div class="topbar__inner">
        <a class="brand" href="${ctx}/">
            <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true">
                <path class="brand__needle" d="M16 19v10"/>
                <circle class="brand__head" cx="16" cy="12" r="9"/>
                <circle class="brand__shine" cx="12.5" cy="8.5" r="2.4"/>
            </svg>
            <span class="brand__name">Pass It On</span>
        </a>

        <nav class="mainnav" aria-label="Main">
            <a href="${ctx}/" aria-current="${nav == 'home' ? 'page' : 'false'}">Browse</a>
            <a href="${ctx}/listing/new" aria-current="${nav == 'sell' ? 'page' : 'false'}">Sell</a>
            <a href="${ctx}/wishlist" aria-current="${nav == 'wishlist' ? 'page' : 'false'}">Wishlist</a>
            <a href="${ctx}/offers" aria-current="${nav == 'offers' ? 'page' : 'false'}">Offers</a>
            <c:if test="${not empty sessionScope.user}">
                <a href="${ctx}/dashboard" aria-current="${nav == 'dashboard' ? 'page' : 'false'}">Dashboard</a>
            </c:if>
            <c:if test="${sessionScope.user.admin}">
                <a href="${ctx}/admin/reports" aria-current="${nav == 'admin' ? 'page' : 'false'}">Admin</a>
            </c:if>
        </nav>

        <div class="topbar__actions">
            <button type="button" class="icon-btn theme-toggle" aria-pressed="false" title="Dark mode">
                <span class="visually-hidden">Dark mode</span>
                <svg class="icon icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
                <svg class="icon icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"/></svg>
            </button>
            <c:choose>
                <c:when test="${not empty sessionScope.user}">
                    <a class="user-chip" href="${ctx}/profile">
                        <c:choose>
                            <c:when test="${not empty sessionScope.user.avatar}"><img class="avatar avatar--xs" src="${ctx}/photo/${fn:escapeXml(sessionScope.user.avatar)}" alt="" width="28" height="28"></c:when>
                            <c:otherwise><span class="avatar avatar--xs" aria-hidden="true"><c:out value="${sessionScope.user.initial}"/></span></c:otherwise>
                        </c:choose>
                        <span class="user-chip__name"><c:out value="${sessionScope.user.name}"/></span>
                    </a>
                    <form class="inline-form" method="post" action="${ctx}/logout">
                        <input type="hidden" name="csrf" value="${sessionScope.csrf}">
                        <button type="submit" class="btn btn--ghost btn--sm">Log out</button>
                    </form>
                </c:when>
                <c:otherwise>
                    <a class="btn btn--ghost btn--sm" href="${ctx}/login">Log in</a>
                    <a class="btn btn--primary btn--sm" href="${ctx}/register">Sign up</a>
                </c:otherwise>
            </c:choose>
        </div>
    </div>
</header>

<nav class="tabbar" aria-label="Main">
    <a href="${ctx}/" aria-current="${nav == 'home' ? 'page' : 'false'}">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 10.5 12 3.5l8.5 7V20a1 1 0 0 1-1 1H15v-6H9v6H4.5a1 1 0 0 1-1-1z"/></svg>
        <span>Home</span>
    </a>
    <a href="${ctx}/wishlist" aria-current="${nav == 'wishlist' ? 'page' : 'false'}">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-9.3-9.4A4.9 4.9 0 0 1 12 6.6a4.9 4.9 0 0 1 9.3 4.5c-1.8 4.8-9.3 9.4-9.3 9.4z"/></svg>
        <span>Wishlist</span>
    </a>
    <a class="tabbar__sell" href="${ctx}/listing/new" aria-current="${nav == 'sell' ? 'page' : 'false'}">
        <span class="tabbar__bubble"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></span>
        <span>Sell</span>
    </a>
    <a href="${ctx}/offers" aria-current="${nav == 'offers' ? 'page' : 'false'}">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12.2V4a1 1 0 0 1 1-1h8.2l8.8 8.8-9.2 9.2z"/><circle cx="7.8" cy="7.8" r="1.6"/></svg>
        <span>Offers</span>
    </a>
    <a href="${ctx}/${empty sessionScope.user ? 'login' : 'profile'}" aria-current="${nav == 'me' ? 'page' : 'false'}">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
        <span>Me</span>
    </a>
</nav>

<c:if test="${not empty sessionScope.flash}">
    <div class="toast toast--${sessionScope.flashType == 'error' ? 'error' : 'ok'}" role="status">
        <p><c:out value="${sessionScope.flash}"/></p>
        <button type="button" class="toast__close" aria-label="Dismiss message">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
    </div>
    <c:remove var="flash" scope="session"/>
    <c:remove var="flashType" scope="session"/>
</c:if>

<main id="main" class="page">
