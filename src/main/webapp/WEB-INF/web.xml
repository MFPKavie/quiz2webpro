<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_1.xsd"
         version="6.1">

    <display-name>Pass It On</display-name>

    <!-- local defaults; on a host, the PIO_DB_URL and PIO_DB_USER environment variables replace them.
         The database password always comes from PIO_DB_PASSWORD, never this file. -->
    <context-param>
        <param-name>dbUrl</param-name>
        <param-value>jdbc:mysql://localhost:3306/passiton?useUnicode=true&amp;characterEncoding=UTF-8</param-value>
    </context-param>
    <context-param>
        <param-name>dbUser</param-name>
        <param-value>pio_app</param-value>
    </context-param>

    <!-- filters run in the order they are declared here: Encoding, Auth, Csrf, Admin -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.passiton.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.passiton.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name> <!-- not /listing/*: that would also block the public /listing?id= page -->
        <url-pattern>/listing/new</url-pattern>
        <url-pattern>/listing/edit</url-pattern>
        <url-pattern>/listing/delete</url-pattern>
        <url-pattern>/listing/status</url-pattern>
        <url-pattern>/offer/*</url-pattern>
        <url-pattern>/offers</url-pattern>
        <url-pattern>/api/*</url-pattern>
        <url-pattern>/wishlist</url-pattern>
        <url-pattern>/review/*</url-pattern>
        <url-pattern>/profile</url-pattern>
        <url-pattern>/report</url-pattern>
        <url-pattern>/dashboard</url-pattern>
        <url-pattern>/admin/*</url-pattern>
        <url-pattern>/logout</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>CsrfFilter</filter-name>
        <filter-class>com.passiton.filter.CsrfFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CsrfFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AdminFilter</filter-name>
        <filter-class>com.passiton.filter.AdminFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AdminFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <error-page>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>

</web-app>
